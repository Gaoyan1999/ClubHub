<Application x:Class="ClubHub.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ClubHub.Wpf.ViewModels"
             xmlns:views="clr-namespace:ClubHub.Wpf.Views">
    <Application.Resources>
        <!-- Tells WPF which view to show for each page view model -->
        <DataTemplate DataType="{x:Type vm:MembersViewModel}">
            <views:MembersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EventsViewModel}">
            <views:EventsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EventDetailViewModel}">
            <views:EventDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BudgetViewModel}">
            <views:BudgetView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
    </Application.Resources>
</Application>
