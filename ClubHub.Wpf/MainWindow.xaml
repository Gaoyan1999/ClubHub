<Window x:Class="ClubHub.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClubHub" Height="650" Width="1050" MinHeight="450" MinWidth="750"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Side menu: picking an item switches the page on the right -->
        <DockPanel Background="#1F2937">
            <TextBlock DockPanel.Dock="Top" Text="ClubHub" Foreground="White"
                       FontSize="22" FontWeight="Bold" Margin="16,20,16,12" />
            <TextBlock DockPanel.Dock="Top" Text="CLUB" Foreground="#9CA3AF" FontSize="11" Margin="16,0,16,4" />
            <ComboBox DockPanel.Dock="Top" Margin="16,0,16,16" ItemsSource="{Binding Clubs}"
                      SelectedItem="{Binding SelectedClub}" DisplayMemberPath="Name" />
            <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage}"
                     Background="Transparent" BorderThickness="0" Foreground="White">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" FontSize="14" Margin="8,6" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
    </Grid>
</Window>
