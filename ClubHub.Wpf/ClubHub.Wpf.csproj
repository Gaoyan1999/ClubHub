<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Lets the project restore and build on macOS; it still only runs on Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClubHub.Core\ClubHub.Core.csproj" />
    <ProjectReference Include="..\ClubHub.Data\ClubHub.Data.csproj" />
    <ProjectReference Include="..\ClubHub.ML\ClubHub.ML.csproj" />
  </ItemGroup>

</Project>
