<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 version so the SkiaSharp chart library gets its .NET build, not the old .NET Framework one -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Lets the project restore and build on macOS; it still only runs on Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Holds the database password, so it is gitignored; see appsettings.example.json -->
    <None Include="appsettings.json" Condition="Exists('appsettings.json')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClubHub.Core\ClubHub.Core.csproj" />
    <ProjectReference Include="..\ClubHub.Data\ClubHub.Data.csproj" />
    <ProjectReference Include="..\ClubHub.ML\ClubHub.ML.csproj" />
  </ItemGroup>

</Project>
