<UserControl x:Class="ClubHub.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4F5D75" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="220" />
        </Grid.RowDefinitions>

        <TextBlock Text="Dashboard" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

        <!-- Date range filter -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <WrapPanel>
                <TextBlock Text="Months before and after today" VerticalAlignment="Center" Margin="0,0,8,8" />
                <Slider Width="160" Margin="0,0,8,8" VerticalAlignment="Center" Minimum="1" Maximum="12"
                        TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                        Value="{Binding MonthsAround}" />
                <TextBlock Text="{Binding MonthsAround, StringFormat='±{0} months'}" VerticalAlignment="Center"
                           Width="70" Margin="0,0,16,8" />
                <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,4,8" />
                <DatePicker Width="130" Margin="0,0,8,8" SelectedDate="{Binding FromDate}" />
                <TextBlock Text="To" VerticalAlignment="Center" Margin="0,0,4,8" />
                <DatePicker Width="130" Margin="0,0,0,8" SelectedDate="{Binding ToDate}" />
            </WrapPanel>
            <TextBlock Text="{Binding ErrorText}" Foreground="Firebrick" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Stat cards -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <UniformGrid Rows="1">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Members" Style="{StaticResource CardLabel}" />
                        <TextBlock Text="{Binding MemberCountText}" Style="{StaticResource CardValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Upcoming events" Style="{StaticResource CardLabel}" />
                        <TextBlock Text="{Binding UpcomingText}" Style="{StaticResource CardValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Attendance rate" Style="{StaticResource CardLabel}" />
                        <TextBlock Text="{Binding AttendanceRateText}" Style="{StaticResource CardValue}" Foreground="#15803D" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="No-show rate" Style="{StaticResource CardLabel}" />
                        <TextBlock Text="{Binding NoShowRateText}" Style="{StaticResource CardValue}" Foreground="Firebrick" />
                    </StackPanel>
                </Border>
            </UniformGrid>
            <TextBlock Text="{Binding RateNote}" Foreground="Gray" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Charts -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Events by type" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <lvc:PieChart Series="{Binding TypeSeries}" LegendPosition="Bottom" />
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Income vs cost per month" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <lvc:CartesianChart Series="{Binding MoneySeries}" XAxes="{Binding MonthAxes}" YAxes="{Binding MoneyAxes}"
                                        LegendPosition="Bottom" />
                </DockPanel>
            </Border>

            <!-- Shown over the charts when the range has no events -->
            <TextBlock Grid.ColumnSpan="2" Text="No events in this date range." FontSize="16" Foreground="Gray"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasEvents}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
