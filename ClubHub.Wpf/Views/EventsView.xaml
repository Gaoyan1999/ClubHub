<UserControl x:Class="ClubHub.Wpf.Views.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="Events &amp; Calendar" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

        <!-- Left: calendar. Bold, tinted days have events; clicking a day filters the list -->
        <StackPanel Grid.Row="1" Margin="0,0,16,0">
            <Calendar SelectedDate="{Binding SelectedDate}" SelectionMode="SingleDate">
                <Calendar.CalendarDayButtonStyle>
                    <Style TargetType="CalendarDayButton">
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource EventDayConverter}">
                                        <Binding />
                                        <Binding Path="DataContext.EventDays"
                                                 RelativeSource="{RelativeSource AncestorType=Calendar}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Background" Value="#FDE2D4" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Calendar.CalendarDayButtonStyle>
            </Calendar>
            <Button Content="Show all dates" Margin="0,8,0,0" Command="{Binding ShowAllDatesCommand}" />
            <TextBlock Text="Highlighted days have events." Foreground="Gray" TextWrapping="Wrap"
                       Margin="0,8,0,0" MaxWidth="180" HorizontalAlignment="Left" />
        </StackPanel>

        <!-- Right: event list -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <WrapPanel Margin="0,0,0,8">
                <Button Content="New event" Width="88" Margin="0,0,4,4" Command="{Binding AddEventCommand}" />
                <Button Content="Edit" Width="72" Margin="0,0,4,4" Command="{Binding EditEventCommand}" />
                <Button Content="Delete" Width="72" Margin="0,0,4,4" Command="{Binding DeleteEventCommand}" />
                <Button Content="Open details" Width="96" Margin="0,0,4,4" Command="{Binding OpenDetailsCommand}" />
            </WrapPanel>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="Column" CanUserAddRows="False">
                <DataGrid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenDetailsCommand}" />
                </DataGrid.InputBindings>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open details" Command="{Binding OpenDetailsCommand}" />
                        <MenuItem Header="Edit" Command="{Binding EditEventCommand}" />
                        <MenuItem Header="Delete" Command="{Binding DeleteEventCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding Start, StringFormat='ddd d MMM yyyy'}" Width="Auto" />
                    <DataGridTextColumn Header="Start" Binding="{Binding Start, StringFormat='HH:mm'}" Width="Auto" />
                    <DataGridTextColumn Header="End" Binding="{Binding End, StringFormat='HH:mm'}" Width="Auto" />
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="Auto" />
                    <DataGridTextColumn Header="Room" Binding="{Binding Room.Name}" Width="*" />
                    <DataGridTextColumn Header="Going" Width="Auto">
                        <DataGridTextColumn.Binding>
                            <MultiBinding StringFormat="{}{0} / {1}">
                                <Binding Path="GoingCount" />
                                <Binding Path="Capacity" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Waitlist" Binding="{Binding WaitlistCount}" Width="Auto" />
                    <DataGridTextColumn Header="Price" Binding="{Binding TicketPrice, StringFormat=C}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="Gray" Margin="0,8,0,0" />
        </Grid>
    </Grid>
</UserControl>
