<Window x:Class="ClubHub.Wpf.Views.EventDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="460" MinWidth="380" SizeToContent="Height"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,12,8" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Padding" Value="4,3" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
        </Grid.Resources>

        <TextBlock Grid.Row="0" Text="Title" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EventTitle, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="1" Text="Type" />
        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding EventTypes}"
                  SelectedItem="{Binding EventType}" IsEnabled="{Binding IsNew}" />

        <TextBlock Grid.Row="2" Text="Room" />
        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Rooms}" SelectedItem="{Binding Room}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Margin="0">
                        <Run Text="{Binding Name, Mode=OneWay}" />
                        <Run Text="{Binding Capacity, Mode=OneWay, StringFormat=' (holds {0})'}" Foreground="Gray" />
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Grid.Row="3" Text="Date" />
        <DatePicker Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" SelectedDate="{Binding Date}" />

        <TextBlock Grid.Row="4" Text="Time" />
        <Grid Grid.Row="4" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding TimeSlots}" SelectedItem="{Binding StartTime}" ItemStringFormat="hh\:mm" />
            <TextBlock Grid.Column="1" Text="to" Margin="8,0,8,8" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding TimeSlots}" SelectedItem="{Binding EndTime}" ItemStringFormat="hh\:mm" />
        </Grid>

        <TextBlock Grid.Row="5" Text="Capacity" />
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CapacityText, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="6" Text="Ticket price ($)" />
        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding TicketPriceText, UpdateSourceTrigger=PropertyChanged}" />

        <!-- Extra fields depend on the event type -->
        <TextBlock Grid.Row="7" Text="{Binding CostPerHeadLabel}"
                   Visibility="{Binding HasCostPerHead, Converter={StaticResource BoolToVisibility}}" />
        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding CostPerHeadText, UpdateSourceTrigger=PropertyChanged}"
                 Visibility="{Binding HasCostPerHead, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Grid.Row="8" Text="Prize money ($)"
                   Visibility="{Binding IsCompetition, Converter={StaticResource BoolToVisibility}}" />
        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding PrizePoolText, UpdateSourceTrigger=PropertyChanged}"
                 Visibility="{Binding IsCompetition, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Grid.Row="9" Text="Team size"
                   Visibility="{Binding IsCompetition, Converter={StaticResource BoolToVisibility}}" />
        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding TeamSizeText, UpdateSourceTrigger=PropertyChanged}"
                 Visibility="{Binding IsCompetition, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Margin="0,4,0,8">
            <TextBlock Text="{Binding EstimateText}" Foreground="#4F5D75" Margin="0,0,0,4" />
            <TextBlock Text="{Binding ErrorText}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0" />
        </StackPanel>

        <StackPanel Grid.Row="11" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Width="80" Margin="0,0,8,0" IsDefault="True" Command="{Binding SaveCommand}" />
            <Button Content="Cancel" Width="80" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
