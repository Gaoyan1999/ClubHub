<UserControl x:Class="ClubHub.Wpf.Views.BudgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Budget" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MaxWidth="520" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Event" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="{Binding Start, Mode=OneWay, StringFormat=' · {0:ddd d MMM}'}" Foreground="Gray" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <!-- Summary -->
        <Border Grid.Row="2" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12"
                Visibility="{Binding HasEvent, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Margin" Value="0,0,16,4" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                </Grid.Resources>

                <TextBlock Text="Ticket income" Foreground="#4F5D75" />
                <TextBlock Grid.Column="1" Text="{Binding TicketIncomeText}" />
                <TextBlock Grid.Row="1" Text="Other income" Foreground="#4F5D75" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OtherIncomeText}" />
                <TextBlock Grid.Row="2" Text="Actual cost" Foreground="#4F5D75" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalCostText}" />
                <TextBlock Grid.Row="3" Text="Estimated cost" Foreground="#4F5D75" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EstimatedCostText}" />
                <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding ProfitText}" FontSize="16" FontWeight="SemiBold"
                           Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#15803D" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                    <Setter Property="Foreground" Value="Firebrick" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.InputBindings>
                <KeyBinding Key="Delete" Command="{Binding DeleteEntryCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Delete" Command="{Binding DeleteEntryCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='d MMM yyyy'}" Width="Auto" />
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="Auto" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Add / edit form -->
        <Border Grid.Row="4" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0"
                Visibility="{Binding HasEvent, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding FormTitle}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <WrapPanel>
                    <ComboBox Width="90" Margin="0,0,8,8" ItemsSource="{Binding EntryTypes}" SelectedItem="{Binding FormType}" />
                    <TextBlock Text="Description" VerticalAlignment="Center" Margin="0,0,4,8" />
                    <TextBox Width="200" Margin="0,0,8,8" Padding="4,3"
                             Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Amount ($)" VerticalAlignment="Center" Margin="0,0,4,8" />
                    <TextBox Width="90" Margin="0,0,8,8" Padding="4,3"
                             Text="{Binding FormAmountText, UpdateSourceTrigger=PropertyChanged}" />
                    <DatePicker Width="130" Margin="0,0,8,8" SelectedDate="{Binding FormDate}" />
                    <Button Content="Save" Width="72" Margin="0,0,4,8" IsDefault="True" Command="{Binding SaveEntryCommand}" />
                    <Button Content="New" Width="72" Margin="0,0,4,8" Command="{Binding NewEntryCommand}" />
                    <Button Content="Delete" Width="72" Margin="0,0,0,8" Command="{Binding DeleteEntryCommand}" />
                </WrapPanel>
                <TextBlock Text="{Binding ErrorText}" Foreground="Firebrick" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
